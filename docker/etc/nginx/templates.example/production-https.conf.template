server {

        listen 443 ssl http2 default_server;
        listen [::]:443 ssl http2 default_server;

        ssl_certificate /etc/letsencrypt/live/soberitur.ru/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/soberitur.ru/privkey.pem;

        server_name soberitur.ru www.soberitur.ru;

        index index.php;

        client_max_body_size 100M;

        location ~ /(build|images)/ {
                root /var/www/soberitur.ru/www/public;
                expires 1h;
                add_header Cache-Control "public, must-revalidate";
                access_log off;
        }

        location / {
                proxy_http_version 1.1;
                proxy_set_header Host $host;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
                proxy_pass http://localhost:12200;
        }

        access_log /var/log/nginx/soberitur.ru.access.log combined;
        error_log  /var/log/nginx/soberitur.ru.error.log;

}